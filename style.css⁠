* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Poppins', sans-serif;
}

body {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px;
}

#app-container {
    background: #ffffff;
    width: 100%;
    max-width: 800px;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}

h2 {
    text-align: center;
    color: #333;
    margin-bottom: 15px;
}

.creator-layout {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

@media (min-width: 600px) {
    .creator-layout {
        flex-direction: row;
    }
}

.avatar-preview-box {
    flex: 1;
    background: #f0f3f8;
    border-radius: 15px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 250px;
    position: relative;
}

#avatar-display {
    width: 150px;
    height: 220px;
    position: relative;
}

.avatar-layer {
    position: absolute;
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    transition: all 0.2s ease;
}

/* Estilos visuales simulación CSS de capas */
.body-adult-f { background-color: #ffd1dc; border-radius: 50px 50px 20px 20px; }
.body-adult-m { background-color: #e0ac69; border-radius: 40px 40px 20px 20px; }
.body-kid { background-color: #f1c27d; border-radius: 60px 60px 30px 30px; transform: scale(0.85); }

.customizer-panel {
    flex: 1.2;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.category-tabs {
    display: flex;
    gap: 5px;
    overflow-x: auto;
}

.category-tabs button {
    background: #eef2f5;
    border: none;
    padding: 8px 12px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    font-size: 12px;
    white-space: nowrap;
}

.category-tabs button:hover {
    background: #764ba2;
    color: white;
}

.options-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    max-height: 150px;
    overflow-y: auto;
    background: #fafafa;
    padding: 10px;
    border-radius: 10px;
}

.opt-card {
    background: white;
    border: 2px solid #ddd;
    padding: 10px;
    border-radius: 8px;
    text-align: center;
    font-size: 12px;
    cursor: pointer;
    font-weight: 600;
}

.opt-card:hover {
    border-color: #667eea;
}

.inputs-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.inputs-box input {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 8px;
}

.inputs-box button {
    background: #667eea;
    color: white;
    border: none;
    padding: 12px;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
}

.hidden { display: none; }
